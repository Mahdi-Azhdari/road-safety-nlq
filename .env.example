# Road Safety Assistant — environment variables
#
# Copy this file to .env and fill in your values.
# Never commit the .env file itself — it is in .gitignore.
#
# The Streamlit app takes all credentials from the sidebar at runtime,
# so these variables are only required when running the benchmark script.

# ── LLM API keys ──────────────────────────────────────────────────────────────
# Set the key for whichever provider you are using (Gemini or OpenAI).

GEMINI_API_KEY=

# Optional: response-layer LLM for narrative summaries (can be the same key).
RESPONSE_GEMINI_API_KEY=
RESPONSE_GEMINI_MODEL=

# OpenAI (set if using OpenAI as the primary provider)
# OPENAI_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Used by the benchmark script. The Streamlit app takes these from the sidebar.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=roadsafety
DB_USER=postgres
DB_PASSWORD=
